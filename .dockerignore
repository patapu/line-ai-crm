# [D] Keeps the Docker build context small and out of the image. See
# Dockerfile and docs/design.md section 10.

.git
node_modules
.next

# Env files hold real secrets locally, never send them into the build
# context. .env.example is a placeholder file only, exclude it too since the
# build does not need it.
**/.env
**/.env.*

.vercel

.context
.claude

tests
coverage
*.log

# Database dumps and backups must never enter the build context.
*.sql
*.dump
backups

# Real per-server env files under deploy/ must never enter the build context.
deploy/*.env

build.ps1
Dockerfile
.dockerignore

docs

# Regenerated by `prisma generate` inside the build stage.
lib/generated
