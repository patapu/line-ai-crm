# [F] .env.example: see docs/design.md section 8. No real secrets below.
# Copy to .env and fill in real values for local dev. docker-compose.yml
# hardcodes its own POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB values
# for the `db` service; it does not read these variable names. The
# DATABASE_URL / DIRECT_URL defaults below simply match those hardcoded
# values so the two stay in sync by convention, not by compose reading this
# file.

# Connection: DATABASE_URL is the pooled URL at runtime (lib/db.ts, PrismaPg
# adapter). DIRECT_URL is the non-pooled URL used by prisma.config.ts for
# migrate/introspect. Locally there is no pooler, so both point at the same
# compose `db` service.
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"
DIRECT_URL="postgresql://crm:crm@localhost:5432/crm"

# Auth: SESSION_SECRET must be at least 32 bytes. Generate a real one with
# `openssl rand -base64 32` before deploying; the value below is a local-only
# placeholder.
SESSION_SECRET="dev-only-session-secret-change-me-32bytes-min"
APP_URL="http://localhost:3000"

# Copilot (Gemini via @ai-sdk/google). Leave GOOGLE_GENERATIVE_AI_API_KEY
# empty to force the rule-based fallback path.
GOOGLE_GENERATIVE_AI_API_KEY=""
COPILOT_MODEL="gemini-flash-latest"
COPILOT_TIMEOUT_MS="8000"
COPILOT_MIN_CONFIDENCE="0.5"

# LINE Messaging API: LINE_MODE=mock needs no real LINE credentials.
# Switch to LINE_MODE=live and fill in the channel secret/token to hit the
# real LINE API.
LINE_MODE="mock"
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_INBOUND_OWNER_EMAIL="admin@crm.test"

# Ops
LOG_LEVEL="info"

# Seed only (prisma/seed.ts). Never read outside the seed script.
DEMO_PASSWORD="changeme-demo-password"
