# [D] Copy to /root/ai-crm-stack/ai-crm.env on the VPS, fill in real values,
# then `chmod 600 ai-crm.env`. Never commit the real file. See
# deploy/README.md for the full runbook. Compose reads this through
# `env_file` in deploy/compose.yml, so no --env-file flag is needed.

# Connection: no pooler on this box, so DATABASE_URL and DIRECT_URL are the
# same URL, pointed at the compose `ai-crm-db` service by its service name.
# The password here must match POSTGRES_PASSWORD in db.env (see
# deploy/db.env.example), same hex value in both places.
DATABASE_URL=postgresql://crm_app:CHANGE_ME@ai-crm-db:5432/ai_crm
DIRECT_URL=postgresql://crm_app:CHANGE_ME@ai-crm-db:5432/ai_crm

# Auth: generate with `openssl rand -base64 48`. The placeholder below is
# deliberately shorter than 32 characters so the app refuses to start if you
# forget to change it (see lib/env.ts min(32)).
SESSION_SECRET=CHANGE_ME
APP_URL=https://ai-crm.kurpakorn.com

# Copilot (Gemini via @ai-sdk/google). Leave empty to force the rule-based
# fallback path.
GOOGLE_GENERATIVE_AI_API_KEY=
COPILOT_MODEL=gemini-flash-latest
# Live eval 2026-09-17: 8000ms timed out 3 of 7 cases; 25000ms passed 7 of 7
# at about 3.4 to 7.4s. 15000ms leaves headroom over the passing cases and
# stays well under Caddy / route limits. Pakorn decides if this needs to
# change later.
COPILOT_TIMEOUT_MS=15000
COPILOT_MIN_CONFIDENCE=0.5

# LINE Messaging API: start with mock, switch to live once verified.
LINE_MODE=mock
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_INBOUND_OWNER_EMAIL=admin@crm.test

# Ops
LOG_LEVEL=info

# Seed only (prisma/seed.ts). Set this temporarily to run the seed, then
# remove it from this file again.
# DEMO_PASSWORD=CHANGE_ME_demo_password
