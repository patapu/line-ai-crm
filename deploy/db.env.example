# [D] Copy to /root/ai-crm-stack/db.env on the VPS, fill in the real
# password, then `chmod 600 db.env`. Never commit the real file. Compose
# reads this through `env_file` for the ai-crm-db service only.

POSTGRES_USER=crm_app
# Generate with `openssl rand -hex 24` (hex avoids URL-encoding problems
# inside DATABASE_URL / DIRECT_URL). This must match the password inside
# DATABASE_URL and DIRECT_URL in ai-crm.env.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_crm
